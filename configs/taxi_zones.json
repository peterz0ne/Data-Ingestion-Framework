{
    "dataset": "taxi_zones",
    "schema_version": "1.0",
    "schema": {
        "LocationID": "int",
        "Borough": "string",
        "Zone": "string",
        "service_zone": "string"
    },
    "source": {
        "format": "csv",
        "paths": [
            "/opt/spark/landing/taxi_zone_lookup/taxi_zone_lookup.csv"
        ],
        "options": {
            "header": true,
            "inferSchema": true
        }
    },
    "operations": [
        {
            "action": "rename_columns",
            "parameters": {
                "source": [
                    "LocationID",
                    "Borough",
                    "Zone"
                ],
                "target": [
                    "location_id",
                    "borough",
                    "zone"
                ]
            }
        }
    ],
    "quality_checks": [
        {
            "action": "validate_primary_key",
            "parameters": {
                "columns": [
                    "LocationID"
                ]
            }
        },
        {
            "action": "validate_null_values",
            "parameters": {
                "columns": ["Zone"],
                "null_values": ["N/A"]
            }
        }
    ],
    "cross_batch_quality_checks": [
        {
            "action": "validate_primary_key",
            "parameters": {
                "columns": [
                    "location_id"
                ]
            }
        }
    ]
}