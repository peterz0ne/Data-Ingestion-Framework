{
  "problem": {
    "name": "credit_card_tip_prediction",
    "target_column": "tip_amount",
    "prediction_description": "Immediately when the trip ends, before the customer pays, estimate the expected recorded tip amount for credit-card trips.",
    "payment_type_filter": 1
  },
  "dataset": {
    "table": "gold_ml_tip_training",
    "id_column": "trip_id",
    "split_column": "dataset_split",
    "train_percentage": 70,
    "validation_percentage": 15,
    "test_percentage": 15,
    "split_seed": 42
  },
  "features": {
    "numeric_columns": [
        "passenger_count",
        "trip_distance",
        "trip_duration_minutes",
        "fare_amount",
        "temp_pu",
        "rhum_pu",
        "prcp_pu",
        "temp_do",
        "rhum_do",
        "prcp_do",
        "average_value_pu",
        "average_value_do"
    ],
    "categorical_columns": [
      "vendor_id",
      "rate_code_id",
      "pickup_zone_id",
      "dropoff_zone_id"
    ],
    "datetime_columns": [
      "pickup_datetime",
      "dropoff_datetime"
    ]
  },
  "model": {
    "features_column": "features",
    "label_column": "tip_amount",
    "prediction_column": "prediction",
    "output_path": "models/tip_regressor"
  }
}