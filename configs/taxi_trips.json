{
    "dataset": "taxi_trips",
    "schema_version": "1.0",
    "schema": {
        "VendorID": "int",
        "tpep_pickup_datetime": "timestamp_ntz",
        "tpep_dropoff_datetime": "timestamp_ntz",
        "passenger_count": "bigint",
        "trip_distance": "double",
        "RatecodeID": "bigint",
        "store_and_fwd_flag": "string",
        "PULocationID": "int",
        "DOLocationID": "int",
        "payment_type": "bigint",
        "fare_amount": "double",
        "extra": "double",
        "mta_tax": "double",
        "tip_amount": "double",
        "tolls_amount": "double",
        "improvement_surcharge": "double",
        "total_amount": "double",
        "congestion_surcharge": "double",
        "Airport_fee": "double"
    },
    "source": {
        "format": "parquet",
        "paths": [
            "/opt/spark/data/taxi/yellow_tripdata_2024-01.parquet",
            "/opt/spark/data/taxi/yellow_tripdata_2024-02.parquet",
            "/opt/spark/data/taxi/yellow_tripdata_2024-03.parquet"
        ],
        "options": {}
    },
    "operations": [
        {
            "action": "rename_columns",
            "parameters": {
                "source": [
                    "VendorID",
                    "tpep_pickup_datetime",
                    "tpep_dropoff_datetime",
                    "RatecodeID",
                    "PULocationID",
                    "DOLocationID",
                    "Airport_fee"
                ],
                "target": [
                    "vendor_id",
                    "pickup_datetime",
                    "dropoff_datetime",
                    "rate_code_id",
                    "pickup_zone_id",
                    "dropoff_zone_id",
                    "airport_fee"
                ]
            }
        },
        {
            "action": "generate_primary_key",
            "parameters": {
                "column": "trip_id",
                "strategy": "incremental",
                "start": 1
            }
        },
        {
            "action": "convert_to_utc",
            "parameters": {
                "columns": [
                    "pickup_datetime",
                    "dropoff_datetime"
                ],
                "source_timezone": "America/New_York"
            }
        }
    ]
}